function countVowels(str) {
  let count = 0;

  for (let i = 0; i < str.length; i++) {
    let chars = str[i].toLowerCase();

    // if (ch === "a" || ch === "e" || ch === "i" || ch === "o" || ch === "u") {
    //   count++;
    // }
    if ("aeiou".includes(chars)) {
      count++;
    }
  }

  return count;
}

const result = countVowels("HELLO  a  i there");
console.log(result);
